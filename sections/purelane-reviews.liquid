<section id="reviews" class="plreviews">

  <div class="plreviews__head">
    <div class="plreviews__head-inner">
      {% if section.settings.kicker != blank %}
        <span class="plreviews__kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      {% if section.settings.aggregate_rating != blank %}
        <span class="plreviews__agg">
          <span class="plreviews__stars" aria-hidden="true">★★★★★</span>
          <b>{{ section.settings.aggregate_rating }}</b>
          {{ section.settings.aggregate_label }}
        </span>
      {% endif %}
      {% if section.settings.homes_label != blank %}
        <span class="plreviews__agg">
          {{ section.settings.homes_label }}
        </span>
      {% endif %}
    </div>
  </div>

  <div
    class="plreviews__rail"
    aria-label="Customer reviews"
    role="region"
  >
    <div class="plreviews__track" id="plreviews-track-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <article class="plreviews__card" {{ block.shopify_attributes }}>
            <div class="plreviews__card-stars" aria-label="5 out of 5 stars">★★★★★</div>
            {% if block.settings.title != blank %}
              <h3 class="plreviews__card-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.body != blank %}
              <p class="plreviews__card-body">{{ block.settings.body }}</p>
            {% endif %}
            <div class="plreviews__card-who">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m5 13 4 4L19 7"/>
              </svg>
              <b>{{ block.settings.author }}</b>
              {% if block.settings.product != blank %}
                <span>· {{ block.settings.product }}</span>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}

      {%- comment -%} Duplicate track for seamless loop {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <article class="plreviews__card" aria-hidden="true">
            <div class="plreviews__card-stars">★★★★★</div>
            {% if block.settings.title != blank %}
              <h3 class="plreviews__card-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.body != blank %}
              <p class="plreviews__card-body">{{ block.settings.body }}</p>
            {% endif %}
            <div class="plreviews__card-who">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m5 13 4 4L19 7"/>
              </svg>
              <b>{{ block.settings.author }}</b>
              {% if block.settings.product != blank %}
                <span>· {{ block.settings.product }}</span>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>

</section>

<style>
.plreviews {
  padding: 60px 0;
  background: var(--pl-bg, #EAF7EE);
  overflow: hidden;
}

.plreviews__head {
  margin-bottom: 28px;
}

.plreviews__head-inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 18px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px 28px;
}

.plreviews__kicker {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #241A3D;
  opacity: 0.6;
}

.plreviews__agg {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.78rem;
  color: #241A3D;
}

.plreviews__stars {
  color: #B8701C;
  font-size: 0.9rem;
  letter-spacing: 1px;
}

.plreviews__agg b { color: #17102B; font-weight: 700; }

/* RAIL */
.plreviews__rail {
  width: 100%;
  overflow: hidden;
}

.plreviews__track {
  display: flex;
  gap: 14px;
  width: max-content;
  animation: plreviews-scroll 32s linear infinite;
}

.plreviews__track:hover {
  animation-play-state: paused;
}

@keyframes plreviews-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* CARD */
.plreviews__card {
  flex: 0 0 280px;
  padding: 20px 18px;
  border-radius: 20px;
  background: rgba(255,255,255,0.7);
  border: 1px solid rgba(75,58,143,0.1);
  box-shadow: 0 4px 18px rgba(0,64,55,0.07);
  backdrop-filter: blur(10px);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.plreviews__card-stars {
  color: #B8701C;
  font-size: 0.85rem;
  letter-spacing: 1px;
}

.plreviews__card-title {
  margin: 0;
  font-family: Outfit, system-ui, sans-serif;
  font-size: 0.82rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #17102B;
}

.plreviews__card-body {
  margin: 0;
  font-size: 0.78rem;
  color: #241A3D;
  line-height: 1.55;
  flex: 1;
}

.plreviews__card-who {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.68rem;
  color: #241A3D;
  margin-top: 4px;
}

.plreviews__card-who svg { color: #00706A; flex-shrink: 0; }
.plreviews__card-who b { color: #17102B; font-weight: 700; }
.plreviews__card-who span { opacity: 0.6; }

@media (max-width: 600px) {
  .plreviews__card { flex: 0 0 240px; }
  .plreviews__track { gap: 10px; }
}

@media (prefers-reduced-motion: reduce) {
  .plreviews__track { animation: none; }
}
</style>

{% schema %}
{
  "name": "Reviews Rail",
  "tag": "section",
  "class": "section-purelane-reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "aggregate_rating",
      "label": "Aggregate rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "aggregate_label",
      "label": "Aggregate label",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "homes_label",
      "label": "Homes label",
      "default": "Loved by 12 lakh+ homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review body",
