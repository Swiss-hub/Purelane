<section id="bundles" class="plbundles">
  <div class="plbundles__inner">

    <div class="plbundles__head">
      {% if section.settings.kicker != blank %}
        <p class="plbundles__kicker">{{ section.settings.kicker }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="plbundles__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="plbundles__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="plbundles__grid">
      {% for block in section.blocks %}
        {% if block.type == 'tier' %}
          <article
            class="plbundles__card{% if block.settings.featured %} plbundles__card--featured{% endif %}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.tag != blank %}
              <span class="plbundles__tag">{{ block.settings.tag }}</span>
            {% endif %}

            <div class="plbundles__visual">
              {% assign p1 = block.settings.product_1 %}
              {% assign p2 = block.settings.product_2 %}
              {% assign p3 = block.settings.product_3 %}
              {% assign p4 = block.settings.product_4 %}
              {% assign p5 = block.settings.product_5 %}

              {% for i in (1..5) %}
                {% assign pkey = 'product_' | append: i %}
                {% assign prod = block.settings[pkey] %}
                {% if prod != blank %}
                  <div class="plbundles__visual-prod">
                    {% if prod.featured_image %}
                      {{ prod.featured_image | image_url: width: 100 | image_tag:
                        loading: 'lazy',
                        alt: prod.title,
                        class: 'plbundles__visual-img'
                      }}
                    {% else %}
                      <div class="plbundles__visual-placeholder"></div>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <div class="plbundles__qty">
              <span class="plbundles__qty-num">{{ block.settings.quantity }}</span>
              <span class="plbundles__qty-label">{{ block.settings.quantity_label | default: 'Products' }}</span>
            </div>

            <div class="plbundles__pricing">
              <span class="plbundles__price">{{ block.settings.price }}</span>
              {% if block.settings.compare_price != blank %}
                <s class="plbundles__compare">{{ block.settings.compare_price }}</s>
              {% endif %}
            </div>

            {% if block.settings.price_note != blank %}
              <p class="plbundles__price-note">{{ block.settings.price_note }}</p>
            {% endif %}

            {% if block.settings.feature_1 != blank or block.settings.feature_2 != blank or block.settings.feature_3 != blank %}
              <ul class="plbundles__features">
                {% if block.settings.feature_1 != blank %}
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                    {{ block.settings.feature_1 }}
                  </li>
                {% endif %}
                {% if block.settings.feature_2 != blank %}
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                    {{ block.settings.feature_2 }}
                  </li>
                {% endif %}
                {% if block.settings.feature_3 != blank %}
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                    {{ block.settings.feature_3 }}
                  </li>
                {% endif %}
              </ul>
            {% endif %}

            <a
              class="plbundles__btn{% if block.settings.featured %} plbundles__btn--primary{% endif %}"
              href="{{ block.settings.cta_url }}"
            >
              {{ block.settings.cta_label | default: 'Shop bundle' }}
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h13"/>
                <path d="m13 6 6 6-6 6"/>
              </svg>
            </a>

          </article>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
.plbundles {
  padding: 80px 0;
  background: var(--pl-bg, #EAF7EE);
}

.plbundles__inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 18px;
}

.plbundles__head {
  text-align: center;
  margin-bottom: 48px;
  padding: 40px 32px;
  border-radius: 24px;
  background: rgba(255,255,255,0.6);
  border: 1px solid rgba(75,58,143,0.1);
  backdrop-filter: blur(12px);
}

.plbundles__kicker {
  margin: 0 0 10px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #B8701C;
}

.plbundles__heading {
  margin: 0 0 12px;
  font-family: Outfit, system-ui, sans-serif;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  text-transform: uppercase;
  color: #17102B;
  line-height: 1;
}

.plbundles__subheading {
  max-width: 52ch;
  margin: 0 auto;
  color: #241A3D;
  font-size: clamp(0.9rem, 1.2vw, 1rem);
  line-height: 1.6;
}

/* GRID */
.plbundles__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}

@media (min-width: 760px) {
  .plbundles__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* CARD */
.plbundles__card {
  padding: 24px 20px;
  border-radius: 24px;
  background: rgba(255,255,255,0.65);
  border: 1px solid rgba(75,58,143,0.1);
  box-shadow: 0 4px 24px rgba(0,64,55,0.07);
  backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: transform 300ms ease;
}

.plbundles__card:hover { transform: translateY(-5px); }

.plbundles__card--featured {
  border-color: rgba(184,112,28,0.44);
  box-shadow: 0 8px 40px rgba(0,64,55,0.14), 0 0 0 1px rgba(184,112,28,0.2);
}

.plbundles__tag {
  display: inline-block;
  padding: 5px 12px;
  border-radius: 999px;
  font-size: 0.58rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  background: rgba(184,112,28,0.12);
  border: 1px solid rgba(184,112,28,0.28);
  color: #B8701C;
  align-self: flex-start;
}

/* VISUAL */
.plbundles__visual {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 4px;
  padding: 16px 12px;
  border-radius: 16px;
  background: linear-gradient(160deg, rgba(236,230,247,0.3), rgba(75,58,143,0.08));
  border: 1px solid rgba(75,58,143,0.1);
  min-height: 100px;
}

.plbundles__visual-prod { flex: 0 0 auto; }

.plbundles__visual-img {
  height: 70px;
  width: auto;
  object-fit: contain;
}

.plbundles__visual-placeholder {
  width: 36px;
  height: 70px;
  border-radius: 8px;
  background: linear-gradient(160deg, rgba(107,85,184,0.5), rgba(107,85,184,0.25));
}

/* QTY */
.plbundles__qty {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.plbundles__qty-num {
  font-family: Outfit, system-ui, sans-serif;
  font-size: 3.2rem;
  font-weight: 800;
  color: #17102B;
  line-height: 0.9;
  letter-spacing: -0.04em;
}

.plbundles__qty-label {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #241A3D;
  opacity: 0.6;
}

/* PRICING */
.plbundles__pricing {
  display: flex;
  align-items: baseline;
  gap: 10px;
}

.plbundles__price {
  font-family: Outfit, system-ui, sans-serif;
  font-size: 1.7rem;
  font-weight: 800;
  color: #B8701C;
  line-height: 1;
}

.plbundles__compare {
  font-size: 0.85rem;
  color: #241A3D;
  opacity: 0.5;
}

.plbundles__price-note {
  margin: 0;
  font-size: 0.72rem;
  color: #241A3D;
  opacity: 0.6;
}

/* FEATURES */
.plbundles__features {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.plbundles__features li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.82rem;
  color: #241A3D;
}

.plbundles__features svg {
  color: #00706A;
  flex-shrink: 0;
}

/* BUTTON */
.plbundles__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 13px;
  border-radius: 999px;
  border: 1.5px solid rgba(17,16,43,0.18);
  background: transparent;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #17102B;
  text-decoration: none;
  transition: background 200ms ease, color 200ms ease;
  margin-top: auto;
}

.plbundles__btn:hover {
  background: #17102B;
  color: #fff;
}

.plbundles__btn--primary {
  background: #00706A;
  color: #fff;
  border-color: #00706A;
}

.plbundles__btn--primary:hover {
  background: #005450;
  border-color: #005450;
}

.plbundles__btn:focus-visible {
  outline: 2px solid #B8701C;
  outline-offset: 3px;
}

@media (max-width: 760px) {
  .plbundles__head { padding: 28px 20px; }
  .plbundles__qty-num { font-size: 2.6rem; }
}

@media (prefers-reduced-motion: reduce) {
  .plbundles__card { transition: none; }
}
</style>

{% schema %}
