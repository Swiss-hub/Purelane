<section id="combos" class="plcombos">
  <div class="plcombos__inner">

    <div class="plcombos__head">
      {% if section.settings.kicker != blank %}
        <p class="plcombos__kicker">{{ section.settings.kicker }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="plcombos__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="plcombos__rule" aria-hidden="true">
        <span></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <span></span>
      </div>
      {% if section.settings.subheading != blank %}
        <p class="plcombos__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="plcombos__track-wrap">
      <div class="plcombos__track" id="plcombos-track">
        {% for block in section.blocks %}
          {% if block.type == 'combo' %}
            <article
              class="plcombos__card{% if block.settings.featured %} plcombos__card--featured{% endif %}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.saving_label != blank %}
                <span class="plcombos__save-tag">{{ block.settings.saving_label }}</span>
              {% endif %}

              {% if block.settings.flag != blank %}
                <span class="plcombos__flag">{{ block.settings.flag }}</span>
              {% endif %}

              <div class="plcombos__products">
                {% assign p1 = block.settings.product_1 %}
                {% assign p2 = block.settings.product_2 %}
                {% assign p3 = block.settings.product_3 %}

                {% if p1 != blank %}
                  <div class="plcombos__prod">
                    {% if p1.featured_image %}
                      {{ p1.featured_image | image_url: width: 120 | image_tag:
                        loading: 'lazy',
                        alt: p1.title,
                        class: 'plcombos__prod-img'
                      }}
                    {% else %}
                      <div class="plcombos__prod-placeholder"></div>
                    {% endif %}
                    {% if block.settings.product_1_desc != blank %}
                      <span class="plcombos__prod-desc">{{ block.settings.product_1_desc }}</span>
                    {% endif %}
                  </div>
                  {% if p2 != blank %}<span class="plcombos__plus" aria-hidden="true">+</span>{% endif %}
                {% endif %}

                {% if p2 != blank %}
                  <div class="plcombos__prod">
                    {% if p2.featured_image %}
                      {{ p2.featured_image | image_url: width: 120 | image_tag:
                        loading: 'lazy',
                        alt: p2.title,
                        class: 'plcombos__prod-img'
                      }}
                    {% else %}
                      <div class="plcombos__prod-placeholder"></div>
                    {% endif %}
                    {% if block.settings.product_2_desc != blank %}
                      <span class="plcombos__prod-desc">{{ block.settings.product_2_desc }}</span>
                    {% endif %}
                  </div>
                  {% if p3 != blank %}<span class="plcombos__plus" aria-hidden="true">+</span>{% endif %}
                {% endif %}

                {% if p3 != blank %}
                  <div class="plcombos__prod">
                    {% if p3.featured_image %}
                      {{ p3.featured_image | image_url: width: 120 | image_tag:
                        loading: 'lazy',
                        alt: p3.title,
                        class: 'plcombos__prod-img'
                      }}
                    {% else %}
                      <div class="plcombos__prod-placeholder"></div>
                    {% endif %}
                    {% if block.settings.product_3_desc != blank %}
                      <span class="plcombos__prod-desc">{{ block.settings.product_3_desc }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              <div class="plcombos__card-body">
                <h3 class="plcombos__card-title">{{ block.settings.title }}</h3>
                <p class="plcombos__card-count">{{ block.settings.product_count }}</p>
                {% if block.settings.description != blank %}
                  <p class="plcombos__card-desc">{{ block.settings.description }}</p>
                {% endif %}

                <div class="plcombos__pricing">
                  <strong>{{ block.settings.price }}</strong>
                  {% if block.settings.compare_price != blank %}
                    <s>{{ block.settings.compare_price }}</s>
                  {% endif %}
                  {% if block.settings.saving_label != blank %}
                    <span class="plcombos__save-badge">{{ block.settings.saving_label }}</span>
                  {% endif %}
                </div>

                {% if block.settings.footnote != blank %}
                  <p class="plcombos__footnote">{{ block.settings.footnote }}</p>
                {% endif %}
                <a
                  class="plcombos__btn{% if block.settings.featured %} plcombos__btn--primary{% endif %}"
                  href="{{ block.settings.cta_url }}"
                >
                  {{ block.settings.cta_label | default: 'Shop bundle' }}
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h13"/>
                    <path d="m13 6 6 6-6 6"/>
                  </svg>
                </a>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.blocks.size > 2 %}
        <p class="plcombos__swipe-hint" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13"/><path d="m13 6 6 6-6 6"/></svg>
          {{ section.settings.swipe_hint | default: 'Swipe for more combos' }}
        </p>
      {% endif %}
    </div>

    {% if section.settings.footnote != blank %}
      <p class="plcombos__bottom-note">{{ section.settings.footnote }}</p>
    {% endif %}

  </div>
</section>

<style>
.plcombos {
  padding: 80px 0 60px;
  background: var(--pl-bg, #EAF7EE);
}

.plcombos__inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 18px;
}

.plcombos__head {
  text-align: center;
  margin-bottom: 48px;
}

.plcombos__kicker {
  margin: 0 0 10px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #B8701C;
}

.plcombos__heading {
  margin: 0;
  font-family: Outfit, system-ui, sans-serif;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  text-transform: uppercase;
  color: #17102B;
  line-height: 1;
}

.plcombos__rule {
  display: flex;
  align-items: center;
  gap: 12px;
  width: min(260px, 100%);
  margin: 18px auto 16px;
  color: #B8701C;
}

.plcombos__rule span {
  flex: 1;
  height: 1px;
  background: rgba(75,58,143,0.22);
}

.plcombos__subheading {
  max-width: 52ch;
  margin: 0 auto;
  color: #241A3D;
  font-size: clamp(0.9rem, 1.2vw, 1rem);
  line-height: 1.6;
  text-align: center;
}

/* TRACK */
.plcombos__track-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 8px;
}

.plcombos__track-wrap::-webkit-scrollbar { display: none; }

.plcombos__track {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px;
}

@media (min-width: 900px) {
  .plcombos__track {
    display: flex;
    gap: 16px;
  }
}

/* CARD */
.plcombos__card {
  position: relative;
  flex: 0 0 300px;
  padding: 20px;
  border-radius: 24px;
  background: rgba(255,255,255,0.7);
  border: 1px solid rgba(75,58,143,0.1);
  box-shadow: 0 4px 24px rgba(0,64,55,0.07);
  backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  gap: 16px;
  transition: transform 300ms ease;
}

.plcombos__card:hover { transform: translateY(-4px); }

.plcombos__card--featured {
  border-color: rgba(184,112,28,0.44);
  box-shadow: 0 8px 36px rgba(0,64,55,0.14), 0 0 0 1px rgba(184,112,28,0.2);
}

.plcombos__save-tag {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 0.58rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  background: rgba(0,112,106,0.12);
  border: 1px solid rgba(0,112,106,0.2);
  color: #00706A;
}

.plcombos__flag {
  position: absolute;
  top: 16px;
  right: 16px;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 0.58rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  background: #00706A;
  color: #fff;
}

/* PRODUCTS ROW */
.plcombos__products {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6px;
  padding: 12px 8px;
  border-radius: 16px;
  background: linear-gradient(160deg, rgba(236,230,247,0.3), rgba(75,58,143,0.08));
  border: 1px solid rgba(75,58,143,0.1);
  min-height: 120px;
}

.plcombos__prod {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  flex: 1;
}

.plcombos__prod-img {
  width: auto;
  height: 80px;
  object-fit: contain;
}

.plcombos__prod-placeholder {
  width: 48px;
  height: 80px;
  border-radius: 10px;
  background: linear-gradient(160deg, rgba(107,85,184,0.5), rgba(107,85,184,0.25));
}

.plcombos__prod-desc {
  font-size: 0.58rem;
  font-weight: 600;
  color: #241A3D;
  text-align: center;
  line-height: 1.3;
}

.plcombos__plus {
  font-size: 1rem;
  color: rgba(75,58,143,0.3);
  align-self: center;
  margin-bottom: 24px;
}

/* CARD BODY */
.plcombos__card-body {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
}

.plcombos__card-title {
  margin: 0;
  font-family: Outfit, system-ui, sans-serif;
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: #17102B;
}

.plcombos__card-count {
  margin: 0;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #B8701C;
}

.plcombos__card-desc {
  margin: 4px 0 8px;
  font-size: 0.82rem;
  color: #241A3D;
  line-height: 1.55;
  flex: 1;
}

.plcombos__pricing {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}

.plcombos__pricing strong {
  font-family: Outfit, system-ui, sans-serif;
  font-size: 1.6rem;
  font-weight: 800;
  color: #B8701C;
  line-height: 1;
}

.plcombos__pricing s {
  font-size: 0.82rem;
  color: #241A3D;
  opacity: 0.55;
}

.plcombos__save-badge {
  padding: 3px 9px;
  border-radius: 999px;
  font-size: 0.58rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: rgba(0,112,106,0.1);
  border: 1px solid rgba(0,112,106,0.22);
  color: #00706A;
}

.plcombos__footnote {
  margin: 0;
  font-size: 0.68rem;
  color: #241A3D;
  opacity: 0.55;
}

.plcombos__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 12px;
  border-radius: 999px;
  border: 1.5px solid rgba(17,16,43,0.18);
  background: transparent;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #17102B;
  text-decoration: none;
  transition: background 200ms ease, color 200ms ease;
  margin-top: auto;
}

.plcombos__btn:hover {
  background: #17102B;
  color: #fff;
}

.plcombos__btn--primary {
  background: #00706A;
  color: #fff;
  border-color: #00706A;
}

.plcombos__btn--primary:hover {
  background: #005450;
  border-color: #005450;
}

.plcombos__btn:focus-visible {
  outline: 2px solid #B8701C;
  outline-offset: 3px;
}

.plcombos__swipe-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 20px;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #B8701C;
}

.plcombos__bottom-note {
  text-align: center;
  margin-top: 20px;
  font-size: 0.75rem;
  color: #241A3D;
  opacity: 0.6;
}

@media (prefers-reduced-motion: reduce) {
  .plcombos__card { transition: none; }
}
</style>

{% schema %}
